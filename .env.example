# Kopieren nach .env und anpassen:  cp .env.example .env
# docker compose liest diese Datei automatisch.

# Passwort für den ersten Benutzer "admin" (nur beim allerersten Start verwendet).
# Leer lassen = zufälliges Passwort, steht dann im Log: docker compose logs app
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Zugang aus dem Internet – genau eine Variante wählen:
#   caddy       mitgelieferter HTTPS-Proxy (Ports 80/443 müssen offen sein, DOMAIN setzen)
#   cloudflare  mitgelieferter Cloudflare Tunnel (keine offenen Ports, CLOUDFLARE_TUNNEL_TOKEN setzen)
#   (leer)      nur die App – für einen schon vorhandenen Proxy oder cloudflared
COMPOSE_PROFILES=caddy

# nur für "caddy": öffentliche Adresse (DNS-A/AAAA-Eintrag muss auf den Server zeigen)
DOMAIN=plan.example.de

# nur für "cloudflare": Token des Tunnels aus dem Cloudflare-Dashboard (beginnt mit "eyJ…")
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Port der App auf dem Server (Adresse:Port).
# Ist 3000 schon belegt (z. B. durch Dockhand, Grafana, …), einfach einen freien Port nehmen, z. B. 127.0.0.1:3001.
# 127.0.0.1 = nur vom Server selbst erreichbar (empfohlen). 0.0.0.0 = auch aus dem Netzwerk.
APP_BIND=127.0.0.1:3000

# Anzahl aufbewahrter täglicher Sicherungen
BACKUP_KEEP=14

# --- Nur für Sonderfälle ---
# Cookies nur über HTTPS senden. Auf "false" nur für Tests ohne HTTPS (z. B. Zugriff per http://<IP>:3000 im LAN).
#SECURE_COOKIES=true
# Der App liegt ein Proxy/Tunnel (Caddy, nginx, Cloudflare) vor? Dann true lassen. Bei direktem Zugriff ohne Proxy: false.
#TRUST_PROXY=true
